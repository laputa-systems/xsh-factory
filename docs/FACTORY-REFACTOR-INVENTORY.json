{
  "schema_version": 2,
  "repository_boundary": {
    "factory_root": ".",
    "product_root": "../xsh",
    "factory_owns": ["factory", "tickets", "evals", "templates", "roles", "runtime", "runs"],
    "product_owns": ["../xsh/src", "../xsh/tests", "../xsh/docs"]
  },
  "canonical_namespace": {
    "domain": ["factory/types.xsh", "factory/paths.xsh", "factory/request.xsh", "factory/policy.xsh"],
    "workflow": ["factory/graph.xsh", "factory/dispatch.xsh", "factory/process.xsh", "factory/lifecycle.xsh"],
    "evidence": ["factory/evidence.xsh", "factory/reports.xsh", "factory/schema.xsh", "factory/cleanup.xsh"],
    "reconciliation": ["factory/tickets.xsh", "factory/evals.xsh", "factory/control.xsh", "factory/runtime.xsh"],
    "controllers": ["factory/controllers/organization.xsh", "factory/controllers/ticket.xsh", "factory/controllers/eval.xsh", "factory/controllers/design.xsh", "factory/controllers/reuse.xsh"],
    "entrypoints": ["run.xsh", "factory/entrypoints/run-agent.xsh", "factory/entrypoints/eval-executor.xsh"],
    "tools": [
      "factory/tools/audit.xsh",
      "factory/tools/cto.xsh",
      "factory/tools/report.xsh",
      "factory/tools/reconcile.xsh",
      "factory/tools/session.xsh",
      "factory/tools/session-watch.xsh",
      "factory/tools/budget.xsh",
      "factory/tools/budget-watch.xsh",
      "factory/tools/cycle-budget-watch.xsh",
      "factory/tools/cleanup.xsh",
      "factory/tools/cleanup-run.xsh",
      "factory/tools/clean-factory.xsh",
      "factory/tools/cto-report.xsh",
      "factory/tools/eval-trends.xsh"
    ]
  },
  "operator_entrypoints": {
    "only_paid_cycle_launcher": "run.xsh",
    "canonical": true,
    "secondary_commands": [
      "factory/tools/cto.xsh",
      "factory/tools/report.xsh",
      "factory/tools/reconcile.xsh",
      "factory/tools/audit.xsh"
    ]
  },
  "effects": {
    "pure": ["factory/types.xsh", "factory/paths.xsh", "factory/request.xsh", "factory/policy.xsh", "factory/graph.xsh", "factory/schema.xsh"],
    "effectful_shared": ["factory/dispatch.xsh", "factory/process.xsh", "factory/lifecycle.xsh", "factory/evidence.xsh", "factory/cleanup.xsh", "factory/runtime.xsh"],
    "controller_effects": ["factory/controllers/*.xsh", "factory/entrypoints/*.xsh", "factory/tools/*.xsh"]
  },
  "durable_outputs": {
    "run_root": ["report.json", "CTO-REPORT.md", "events.jsonl", "POSTMORTEM.md", "CTO-IMPROVEMENT.md", "CTO-PRODUCTIVITY-REPORT.md"],
    "phase_root": ["report.json", "required-outputs.json"],
    "worker_root": ["session.jsonl.bz2", "report.json", "REPORT.md"],
    "dispatch_root": ["<dispatch-id>.json", "<dispatch-id>.claim.json"],
    "evidence_roots": ["phases", "workers", "patches", "lineage"]
  },
  "environment_producers": ["run.xsh", "factory/controllers/organization.xsh", "factory/controllers/ticket.xsh", "factory/controllers/eval.xsh", "factory/controllers/design.xsh", "factory/entrypoints/eval-executor.xsh", "factory/entrypoints/run-agent.xsh"],
  "historical_paths": {
    "runs": "runs/** is preserved evidence and is not rewritten",
    "package_image_paths": ["/run/evaluator.xsh"]
  },
  "known_escape_hatches": [
    {"name": "root-entrypoint-delegates", "boundary": "documented operator paths only", "test": "root wrapper reachability audit"},
    {"name": "package-evaluator-process", "boundary": "evals/<id>/evaluator.xsh", "test": "package ownership gate"}
  ]
}
