+#[test]
+fn fmt_string_interpolation_errors_report_true_source_span() {
+    // An invalid token inside `${...}` must be reported at the real byte
+    // offset of the offending token, not at an earlier position on the line
+    // such as the enclosing `proc` signature. The throwaway sub-lexer/parser
+    // that parses interpolation content sits at byte offset 0, so its
+    // diagnostics carry chunk-relative spans that must be shifted by the
+    // interpolation content's absolute offset in the source.
+    let source = "proc main() [io] {\n  print f\"tags: ${lowered.join(', ')}\"\n}\n";
+    let output = Parser::parse_source_arena_only(SourceId::new(0), source);
+
+    let unexpected: Vec<_> = output
+        .diagnostics
+        .iter()
+        .filter(|diag| diag.code.as_deref() == Some("lex.unexpected-character"))
+        .collect();
+    assert!(!unexpected.is_empty(), "expected unexpected-character errors");
+    for diag in &unexpected {
+        let span = diag
+            .labels
+            .iter()
+            .find(|label| label.message.as_deref() == Some("not valid in source"))
+            .expect("primary label")
+            .span;
+        assert_eq!(
+            &source[span.range()],
+            "'",
+            "unexpected-character must point at the real single-quote token"
+        );
+    }
+
+    // A malformed expression inside interpolation is likewise located at the
+    // offending token rather than at the start of the string or the proc line.
+    let malformed = "proc main() [io] {\n  print f\"a ${1 + } b\"\n}\n";
+    let output = Parser::parse_source_arena_only(SourceId::new(0), malformed);
+    let expr = output
+        .diagnostics
+        .iter()
+        .find(|diag| diag.code.as_deref() == Some("parse.expected-expression"))
+        .expect("expected-expression diagnostic");
+    let span = expr
+        .labels
+        .iter()
+        .find(|label| label.message.as_deref() == Some("expected expression"))
+        .expect("primary label")
+        .span;
+    assert_eq!(
+        malformed.as_bytes()[span.start()],
+        b'}',
+        "error must point at the stray brace"
+    );
+}
