+fn shift_diagnostic(mut diagnostic: Diagnostic, offset: usize) -> Diagnostic {
+    shift_span_fix_hint_span_opt(&mut diagnostic.span, offset);
+    for label in &mut diagnostic.labels {
+        label.span.shift_start(offset);
+    }
+    for hint in &mut diagnostic.fix_hints {
+        shift_span_fix_hint_span_opt(&mut hint.span, offset);
+    }
+    diagnostic
+}
+
+fn shift_span_fix_hint_span_opt(span: &mut Option<Span>, offset: usize) {
+    if let Some(span) = span {
+        span.shift_start(offset);
+    }
