-        Type::Int | Type::Str | Type::Bool | Type::Path | Type::Unknown => true,
+        Type::Int | Type::Str | Type::Bool | Type::Path | Type::Unknown | Type::Any => true,
         Type::Record(fields) => fields.values().all(is_sortable_key_type),
         _ => false,
     }
