+#[test]
+fn parser_reports_unknown_block_stream_stage_with_filtering_guidance() {
+    let output = Parser::parse_source_arena_only(
+        SourceId::new(0),
+        "[\"x\"] |> filter { |item| item != \"\" }\n",
+    );
+
+    let diagnostic = output
+        .diagnostics
+        .iter()
+        .find(|diagnostic| diagnostic.code.as_deref() == Some("parse.unknown-stream-stage"))
+        .expect("unknown stream stage diagnostic");
+    assert!(diagnostic.message.contains("filter"), "{diagnostic:?}");
+    assert!(diagnostic.message.contains("where"), "{diagnostic:?}");
+    assert!(
+        output.diagnostics.iter().all(|diagnostic| {
+            !matches!(
+                diagnostic.code.as_deref(),
+                Some("parse.expected-record-field")
+                    | Some("parse.expected-terminator")
+                    | Some("parse.unsupported-operator")
+            )
+        }),
+        "unexpected parse cascade: {:?}",
+        output.diagnostics
+    );
+}
