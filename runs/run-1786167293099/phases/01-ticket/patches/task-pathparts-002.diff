+fn lint_diagnostics_status(diagnostics: &[Diagnostic]) -> u8 {
+    if diagnostics.iter().all(|diagnostic| {
+        diagnostic.severity == Severity::Warning
+            && diagnostic.code.as_deref() == Some("lint.path-constructor")
+    }) {
+        0
+    } else {
+        1
+    }
