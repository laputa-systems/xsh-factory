# Shared runtime for every factory eval. Build this once per cycle from the
# evals/ context; individual eval images inherit it and add only task-specific
# tools and files.
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

ARG PI_RELEASE_URL=https://github.com/joshuarli/pi-headless-bun-musl-static/releases/download/pi-3aeca83d-bun-1.4.0-linux-arm64-musl/pi
ARG PI_RELEASE_SHA256=443d39a4a2565e13edd70068ace8131baf71b3fd1edfa19a9d6b65a2ed7633ed

RUN apk add --no-cache ca-certificates curl libstdc++

ADD --chmod=755 "$PI_RELEASE_URL" /usr/local/bin/pi
RUN echo "$PI_RELEASE_SHA256  /usr/local/bin/pi" | sha256sum -c -

WORKDIR /work

COPY .dist/xsh /usr/local/bin/xsh
COPY .dist/xsht /usr/local/bin/xsht
RUN chmod 0755 /usr/local/bin/xsh /usr/local/bin/xsht

COPY eval-worker.xsh .dist/factory_control.xsh .dist/factory_runtime.xsh .dist/evaluate_common.xsh .dist/evaluate_legacy.xsh /usr/local/lib/xsh-factory/
RUN chmod 0755 /usr/local/lib/xsh-factory/eval-worker.xsh /usr/local/lib/xsh-factory/factory_control.xsh /usr/local/lib/xsh-factory/factory_runtime.xsh /usr/local/lib/xsh-factory/evaluate_common.xsh /usr/local/lib/xsh-factory/evaluate_legacy.xsh

ARG FACTORY_BUILD_ID=unknown
LABEL org.xsh.factory.build-id="${FACTORY_BUILD_ID}"
